# Hosted connector (`thinks-mcp serve --http`). On the server this is /srv/thinks-mcp/.env.

# Public origin. The Telegram bot's domain (BotFather: /setdomain) must match it.
PUBLIC_URL=https://thinks-mcp.aimuzov.online

# Signs access, refresh and session tokens. At least 32 characters: openssl rand -hex 32
# Changing it logs everyone out.
AUTH_SECRET=

# Bot behind the Telegram Login widget. Only the signature check uses the token:
# the server never calls the Bot API.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_NAME=

# Optional. Comma-separated redirect URIs clients may register, on top of loopback.
# Defaults to Claude's callbacks (claude.ai and claude.com).
# ALLOWED_REDIRECT_URIS=

# Optional. Largest accepted Telegram export, in MB (1024), and the build heap (1024).
# THINKS_MAX_UPLOAD_MB=1024
# THINKS_BUILD_HEAP_MB=1024

# Local only: log in as this Telegram id without the widget. Refused unless PUBLIC_URL is localhost.
# PUBLIC_URL=http://localhost:8080
# THINKS_DATA_DIR=./data
# THINKS_DEV_USER_ID=
