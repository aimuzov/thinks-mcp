{
	// Страницы и острова: этот конфиг читают astro check и svelte-check. Сервер, тесты
	// и e2e проверяет tsc по tsconfig.node.json.
	"extends": "astro/tsconfigs/strict",
	"compilerOptions": {
		// Острова берут типы API из сервера: `#thinks/*` ведёт в исходники по этому условию.
		"customConditions": ["thinks-source"],
		"types": ["node"]
	},
	"include": [".astro/types.d.ts", "src/frontend", "astro.config.mjs"],
	"exclude": ["build"]
}
