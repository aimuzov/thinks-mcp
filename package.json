{
	"name": "@aimuzov/thinks-mcp",
	"version": "0.10.0",
	"description": "MCP server that writes, replies and rephrases in your own voice, learned from a Telegram export. Hands the calling model a measured style profile and your real messages — no API keys, no generation of its own.",
	"keywords": [
		"mcp",
		"model-context-protocol",
		"mcp-server",
		"claude",
		"claude-code",
		"claude-desktop",
		"cowork",
		"ai",
		"llm",
		"stdio",
		"telegram",
		"writing-style",
		"personal-voice",
		"style-transfer",
		"russian"
	],
	"homepage": "https://github.com/aimuzov/thinks-mcp#readme",
	"bugs": {
		"url": "https://github.com/aimuzov/thinks-mcp/issues"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/aimuzov/thinks-mcp.git"
	},
	"license": "MIT",
	"author": "Aleksey Imuzov",
	"type": "module",
	"engines": {
		"node": ">=26"
	},
	"bin": {
		"thinks-mcp": "build/index.js"
	},
	"files": [
		"build",
		"README.md",
		"README.ru.md",
		"CHANGELOG.md",
		"LICENSE",
		".mcp.json.example"
	],
	"publishConfig": {
		"access": "public",
		"provenance": true
	},
	"scripts": {
		"start": "node --conditions=thinks-source src/index.ts",
		"build": "rm -rf build && tsc -p tsconfig.build.json && astro build && chmod +x build/index.js",
		"typecheck": "tsc -p tsconfig.node.json",
		"test": "node --conditions=thinks-source --test 'src/**/*.test.ts'",
		"format": "oxlint --fix && prettier --write .",
		"format:check": "prettier --check .",
		"lint": "oxlint --deny-warnings",
		"corpus": "node --conditions=thinks-source --max-old-space-size=8192 src/index.ts build",
		"profile": "node --conditions=thinks-source src/index.ts profile",
		"where": "node --conditions=thinks-source src/index.ts where",
		"prepack": "npm run build",
		"test:ui": "npm run build && node --conditions=thinks-source --test e2e/*.e2e.ts"
	},
	"dependencies": {
		"@aimuzov/infra-mcp-kit": "github:aimuzov/infra-mcp-kit#v3.2.0",
		"zod": "4.6.7"
	},
	"devDependencies": {
		"@aimuzov/infra-site-kit": "github:aimuzov/infra-site-kit#v4.2.0",
		"@astrojs/check": "0.9.12",
		"@astrojs/svelte": "9.1.1",
		"@lucide/svelte": "1.39.0",
		"@modelcontextprotocol/sdk": "1.32.1",
		"@types/node": "26.6.5",
		"astro": "7.4.2",
		"oxlint": "1.87.0",
		"playwright": "1.64.1",
		"postcss-nested": "8.0.1",
		"prettier": "3.9.9",
		"svelte": "5.57.2",
		"svelte-check": "4.7.6",
		"typescript": "6.0.3"
	},
	"imports": {
		"#thinks/*": {
			"thinks-source": "./src/*.ts",
			"default": "./build/*.js"
		},
		"#frontend/*": "./src/frontend/*"
	}
}
